<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="170dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_market_card_white"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Image + Match % Badge -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="105dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_ecomatch_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_mkt_desk"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Rounded8dp" />

        <TextView
            android:id="@+id/tv_ecomatch_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_sale"
            android:backgroundTint="@color/eco_green_primary"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="94% Match" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tv_ecomatch_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/eco_title_dark"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Wooden Study Desk" />

    <!-- Price -->
    <TextView
        android:id="@+id/tv_ecomatch_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/eco_green_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Rs. 8,500" />

    <!-- Location -->
    <TextView
        android:id="@+id/tv_ecomatch_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/eco_secondary_dark"
        android:textSize="11sp"
        tools:text="Malabe • 2.4 km away" />

    <!-- Reason Pill -->
    <TextView
        android:id="@+id/tv_ecomatch_reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_badge_available"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/eco_green_primary"
        android:textSize="10sp"
        tools:text="Matches search" />

</LinearLayout>
