<?xml version="1.0" encoding="utf-8"?>
<!--
    REGISTER SCREEN
    Figma background: cream #F5F0E8 (same as Welcome, NOT white)
    Structure:
      - Top bar: back arrow + "EcoLocal" title (green, centered)
      - Title: "Create your EcoLocal account" (bold, left-aligned, 2 lines)
      - Subtitle: gray, regular, left-aligned
      - Profile photo upload circle (mint bg + camera+ icon)
      - "Upload Profile Photo" label
      - Form fields: Full Name, Email, Password (eye), Confirm Password, Location/Area (pin icon)
      - Create Account button (orange pill, full width)
      - "Already have an account? Sign In" prompt
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_background_cream"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ── Top Bar ─────────────────────────────────────── -->
        <!--
            No extra paddingTop here. The Activity theme sets statusBarColor = cream,
            so content starts naturally below the status bar with cream seamlessly behind it.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/eco_green_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ── Title & Subtitle ──────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="12dp">

            <!-- "Create your EcoLocal account" — bold, large, left-aligned, wraps 2 lines -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:lineSpacingExtra="2dp"
                android:text="@string/register_title"
                android:textColor="@color/eco_text_primary"
                android:textSize="@dimen/register_title_size"
                android:textStyle="bold" />

            <!-- Subtitle — regular, gray -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:text="@string/register_subtitle"
                android:textColor="@color/eco_text_secondary"
                android:textSize="@dimen/register_subtitle_size" />

        </LinearLayout>

        <!-- ── Profile Photo Upload ──────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="4dp">

            <!-- Mint circle background + camera+plus icon -->
            <ImageView
                android:id="@+id/ivProfilePhoto"
                android:layout_width="@dimen/register_profile_circle"
                android:layout_height="@dimen/register_profile_circle"
                android:background="@drawable/bg_profile_photo"
                android:clickable="true"
                android:contentDescription="@string/cd_profile_photo"
                android:focusable="true"
                android:padding="22dp"
                android:src="@drawable/ic_camera_plus" />

            <!-- "Upload Profile Photo" — small, gray, centered -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif"
                android:text="@string/register_upload_photo"
                android:textColor="@color/eco_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- ── Form Fields ────────────────────────────────────── -->
        <!--
            Field background must match the cream screen; use bg_input_field which
            has white fill + gray border, so fields stand out from the cream background.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="16dp">

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_label_name"
                android:textColor="@color/eco_text_primary"
                android:textSize="@dimen/input_label_size" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="@string/register_hint_name"
                android:importantForAutofill="yes"
                android:inputType="textPersonName|textCapWords"
                android:paddingHorizontal="@dimen/input_padding_horizontal"
                android:textColor="@color/eco_text_primary"
                android:textColorHint="@color/eco_text_hint"
                android:textSize="@dimen/input_text_size" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_label_email"
                android:textColor="@color/eco_text_primary"
                android:textSize="@dimen/input_label_size" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="@string/register_hint_email"
                android:importantForAutofill="yes"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/input_padding_horizontal"
                android:textColor="@color/eco_text_primary"
                android:textColorHint="@color/eco_text_hint"
                android:textSize="@dimen/input_text_size" />

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_label_password"
                android:textColor="@color/eco_text_primary"
                android:textSize="@dimen/input_label_size" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="sans-serif"
                    android:hint="@string/register_hint_password"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/input_padding_horizontal"
                    android:paddingEnd="52dp"
                    android:textColor="@color/eco_text_primary"
                    android:textColorHint="@color/eco_text_hint"
                    android:textSize="@dimen/input_text_size" />

                <ImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_toggle_password"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/eco_input_icon" />

            </FrameLayout>

            <!-- Confirm Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_label_confirm"
                android:textColor="@color/eco_text_primary"
                android:textSize="@dimen/input_label_size" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="sans-serif"
                android:hint="@string/register_hint_confirm"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/input_padding_horizontal"
                android:textColor="@color/eco_text_primary"
                android:textColorHint="@color/eco_text_hint"
                android:textSize="@dimen/input_text_size" />

            <!-- Location / Area — has pin icon on left -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/register_label_location"
                android:textColor="@color/eco_text_primary"
                android:textSize="@dimen/input_label_size" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input_field"
                    android:fontFamily="sans-serif"
                    android:hint="@string/register_hint_location"
                    android:importantForAutofill="yes"
                    android:inputType="textPostalAddress"
                    android:paddingStart="48dp"
                    android:paddingEnd="@dimen/input_padding_horizontal"
                    android:textColor="@color/eco_text_primary"
                    android:textColorHint="@color/eco_text_hint"
                    android:textSize="@dimen/input_text_size" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@string/cd_location_icon"
                    android:src="@drawable/ic_location" />

            </FrameLayout>

        </LinearLayout>

        <!-- ── Create Account Button ─────────────────────────── -->
        <!--
            Text-only button (no arrow in Figma for Register).
            FrameLayout not needed since there is no drawableEnd to push text off-center.
        -->
        <Button
            android:id="@+id/btnCreateAccount"
            style="@style/Widget.EcoLocal.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
            android:layout_marginTop="32dp"
            android:text="@string/register_cta"
            app:backgroundTint="@null" />

        <!-- ── Already have an account? Sign In ─────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_sign_in_prompt"
                android:textColor="@color/eco_text_secondary"
                android:textSize="@dimen/text_md" />

            <TextView
                android:id="@+id/tvSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="@string/register_sign_in"
                android:textColor="@color/eco_green_primary"
                android:textSize="@dimen/text_md"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
