<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="68dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Circular icon container -->
    <FrameLayout
        android:layout_width="@dimen/mkt_cat_circle_size"
        android:layout_height="@dimen/mkt_cat_circle_size"
        android:background="@drawable/bg_mkt_cat_circle">

        <ImageView
            android:id="@+id/iv_cat_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_cat_furniture_mkt" />
    </FrameLayout>

    <!-- Label underneath -->
    <TextView
        android:id="@+id/tv_cat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:singleLine="true"
        android:text="Furniture"
        android:textColor="@color/eco_secondary_dark"
        android:textSize="12sp" />

</LinearLayout>
