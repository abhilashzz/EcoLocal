<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_nav_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_height"
    android:background="@color/eco_card_bg"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Home Item -->
    <LinearLayout
        android:id="@+id/nav_item_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/nav_pill_home"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/nav_pill_height"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="2dp"
            android:paddingEnd="14dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/nav_icon_home"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/nav_label_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_home"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Services Item -->
    <LinearLayout
        android:id="@+id/nav_item_services"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/nav_pill_services"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/nav_pill_height"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/nav_icon_services"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_services"
                android:src="@drawable/ic_nav_services" />

            <TextView
                android:id="@+id/nav_label_services"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_services"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Market Item -->
    <LinearLayout
        android:id="@+id/nav_item_market"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/nav_pill_market"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/nav_pill_height"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="2dp"
            android:paddingEnd="14dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/nav_icon_market"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_market"
                android:src="@drawable/ic_nav_market" />

            <TextView
                android:id="@+id/nav_label_market"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_market"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Activity Item -->
    <LinearLayout
        android:id="@+id/nav_item_activity"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/nav_pill_activity"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/nav_pill_height"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/nav_icon_activity"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_activity"
                android:src="@drawable/ic_nav_activity" />

            <TextView
                android:id="@+id/nav_label_activity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_activity"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Profile Item -->
    <LinearLayout
        android:id="@+id/nav_item_profile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/nav_pill_profile"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/nav_pill_height"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="2dp"
            android:paddingEnd="14dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/nav_icon_profile"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_profile"
                android:src="@drawable/ic_nav_profile" />

            <TextView
                android:id="@+id/nav_label_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/nav_profile"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
