<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_bg_screen"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view_services"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="100dp">

            <!-- Top Bar: Avatar + EcoLocal Brand + Bell (Vertically centered) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_services_avatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_avatar_woman"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="EcoLocal"
                    android:textColor="@color/eco_green_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_notifications_services"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:src="@drawable/ic_bell" />
            </RelativeLayout>

            <!-- Screen Title: Community Services -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/title_community_services"
                android:textColor="@color/eco_title_dark"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Search Field (10dp rounded rectangle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_height"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/eco_hint_gray" />

                <EditText
                    android:id="@+id/et_search_services"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:fontFamily="sans-serif"
                    android:hint="@string/search_hint_services"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/eco_text_primary"
                    android:textColorHint="@color/eco_hint_gray"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Filter Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- All (selected) -->
                    <TextView
                        android:id="@+id/chip_services_all"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/chip_height"
                        android:background="@drawable/bg_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="All"
                        android:textColor="@color/eco_chip_selected_text"
                        android:textSize="13sp" />

                    <!-- Tutoring -->
                    <TextView
                        android:id="@+id/chip_services_tutoring"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/chip_height"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Tutoring"
                        android:textColor="@color/eco_chip_unselected_text"
                        android:textSize="13sp" />

                    <!-- Repairs -->
                    <TextView
                        android:id="@+id/chip_services_repairs"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/chip_height"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Repairs"
                        android:textColor="@color/eco_chip_unselected_text"
                        android:textSize="13sp" />

                    <!-- Gardening -->
                    <TextView
                        android:id="@+id/chip_services_gardening"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/chip_height"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Gardening"
                        android:textColor="@color/eco_chip_unselected_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Segmented Control (Service Offers | Help Requests) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/segmented_height"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_segmented_container"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tab_service_offers"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_tab_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/tab_service_offers"
                    android:textColor="@color/eco_title_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_help_requests"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/tab_help_requests"
                    android:textColor="@color/eco_secondary_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Community Services List (Multi-view-type: Offer & Request) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_community_services_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar Include -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="@dimen/nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
